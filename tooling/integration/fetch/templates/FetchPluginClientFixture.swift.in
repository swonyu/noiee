import Foundation

@main struct FetchPluginClientFixture {
    @MainActor static func main() async throws {
        guard CommandLine.arguments.count==3 else {throw FetchPluginSession.failure("Private fixture assembly required")}
        let parent=URL(fileURLWithPath:CommandLine.arguments[1],isDirectory:true),resources=URL(fileURLWithPath:CommandLine.arguments[2],isDirectory:true),session=FetchPluginSession()
        while let line=readLine() {
            do {
                guard let raw=line.data(using:.utf8),let input=try JSONSerialization.jsonObject(with:raw) as? [String:Any] else {throw FetchPluginSession.failure("Invalid fixture request")}
                let value=try await session.perform(input,parent:parent,resources:resources)
                FileHandle.standardOutput.write(try JSONSerialization.data(withJSONObject:value,options:[.sortedKeys]));FileHandle.standardOutput.write(Data([10]))
            }catch {FileHandle.standardOutput.write(try JSONSerialization.data(withJSONObject:["isError":true,"message":error.localizedDescription],options:[.sortedKeys]));FileHandle.standardOutput.write(Data([10]))}
        }
        session.invalidate();await session.drain()
    }
}
