def require(value,message):
    if not value:raise RuntimeError(message)
def derive_root(script):
    p=Path(script);require(p==CHECKS/'fetch-native-suite.py','Wrapper must be at the exact Noiee checks location')
    root=ROOT;require(root.is_relative_to(CACHES) and root!=CACHES,'Exact generated Caches namespace required');return root
def validate_environment(env,root):
    require(type(env) is dict and set(env)==ENV_KEYS and all(type(v) is str and '\0' not in v for v in env.values()),'Exact twelve-key qenv required; ambient/credential fields refused')
