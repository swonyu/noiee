    require(env['NODE_OPTIONS']=='--preserve-symlinks --import='+str(CHECKS/'model-http171-stdio-guard.mjs'),'Exact reviewed preimport guard required')
    require(env['ADMISSION_FILES_HELPER']==ADMISSION and env['HANDOFF_FILES_HELPER']==HANDOFF,'Reviewed helper paths required')
