def guard_exit(text):
    matches=re.findall(r'^PRIVATE_NETWORK_EXIT_GUARD (\{[^\n]*\})$',text,re.M);require(len(matches)==1,'Exactly one Node exit guard receipt required')
    value=json.loads(matches[0]);require(set(value)=={'allowed','denied','unexpected','livePorts'} and all(type(value[k]) is int and value[k]>=0 for k in ['allowed','denied','unexpected']) and value['unexpected']==0 and value['livePorts']==[],'Node guard unexpected sockets or live ports');return value
def end_group(child):
    for sig,seconds in [(signal.SIGTERM,2),(signal.SIGKILL,2)]:
        try:os.killpg(child.pid,sig)
        except ProcessLookupError:pass
        try:child.wait(timeout=seconds);return
        except subprocess.TimeoutExpired:pass
    raise RuntimeError('Owned test stage exit is unconfirmed')
def cancelled(_signal,_frame):raise InterruptedError('Final qualification cancelled')
def run_stage(job,rows):
    require('@installer.parent' not in job['command'],'Unresolved dependency cannot execute');start=time.monotonic();timeout=False
    fd=os.open(job['logPath'],os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW|os.O_CLOEXEC,0o600)
    with os.fdopen(fd,'wb') as output:
        child=subprocess.Popen(job['command'],cwd=job['cwd'],env=job['environment'],stdin=subprocess.DEVNULL,stdout=output,stderr=subprocess.STDOUT,start_new_session=True)
        try:
            try:code=child.wait(timeout=job['timeoutSeconds'])
            except subprocess.TimeoutExpired:timeout=True;end_group(child);code=child.returncode
        except BaseException:end_group(child);raise
        finally:output.flush();os.fsync(output.fileno())
    row={**job,'pid':child.pid,'exitCode':code,'timeoutHit':timeout,'elapsedSeconds':round(time.monotonic()-start,6),'log':reference(Path(job['logPath']))}
    rows.append(row);require(code==0 and not timeout,'Stage did not exit normally: '+job['name']);return row
def write_new(path,value):
    fd=os.open(path,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW|os.O_CLOEXEC,0o600)
    with os.fdopen(fd,'w') as f:json.dump(value,f,indent=2);f.write('\n');f.flush();os.fsync(f.fileno())
def main():
