    return validate_environment(env,root),removed
def private_dir(p,create=False):
    if create:
        try:p.mkdir(mode=0o700)
        except FileExistsError:pass
    s=p.lstat();require(stat.S_ISDIR(s.st_mode) and s.st_uid==os.getuid() and not s.st_mode&0o077 and p.resolve(strict=True)==p,'Private canonical directory required: '+str(p))
def checked(p,limit=2*1024*1024):
    before=p.lstat();require(stat.S_ISREG(before.st_mode) and before.st_uid==os.getuid() and before.st_nlink==1 and not before.st_mode&0o022 and before.st_size<=limit and p.resolve(strict=True)==p,'Unsafe fixed input/output: '+str(p))
    fd=os.open(p,os.O_RDONLY|os.O_NONBLOCK|os.O_NOFOLLOW|os.O_CLOEXEC)
    stamp=lambda s:(s.st_dev,s.st_ino,s.st_mode,s.st_uid,s.st_nlink,s.st_size,s.st_mtime_ns,s.st_ctime_ns)
    try:
        require(stamp(before)==stamp(os.fstat(fd)),'File changed before read');chunks=[];size=0
        while True:
            block=os.read(fd,65536)
            if not block:break
            size+=len(block);require(size<=limit,'File exceeds its bound');chunks.append(block)
        require(size==before.st_size and stamp(before)==stamp(os.fstat(fd))==stamp(p.lstat()),'File changed during read');return b''.join(chunks)
    finally:os.close(fd)
def reference(p):
    data=checked(p);return dict(path=str(p),sha256=hashlib.sha256(data).hexdigest(),bytes=len(data))
def validate_bindings(root):
    private_dir(root);private_dir(CHECKS);private_dir(SOURCE)
    for name,(sha,size) in PINS.items():
        data=checked(CHECKS/name);require(len(data)==size and hashlib.sha256(data).hexdigest()==sha,'Pinned fixture changed: '+name)
    for name,(sha,size) in RUNTIMES.items():
        data=checked(Path(name),size);require(len(data)==size and hashlib.sha256(data).hexdigest()==sha,'Pinned runtime changed')
def native_environment(root):return {'HOME':str(CHECKS/'native-home'),'TMPDIR':str(CHECKS/'native-tmp'),'PATH':'/usr/bin:/bin','LANG':'en_US.UTF-8'}
def command_plan(root,env,parent='@installer.parent'):
    env=validate_environment(env,root);checks=CHECKS
    if parent!='@installer.parent':
        p=Path(parent);require(p.name=='app-parent' and p.parent.parent==root and re.fullmatch(r'fixture-[a-z0-9_]{8}',p.parent.name),'Installer parent must be the exact generated cache role')
    definitions=[('installer',[PYTHON,'-I','-B',str(checks/'test-fetch-plugin.py')],90,env),('native',[str(checks/'fetch-native-check'),parent,str(SOURCE)],45,native_environment(root)),('guards',[NODE,'--preserve-symlinks',str(checks/'fetch-guards-check.mjs')],45,env),('durable',[NODE,'--preserve-symlinks',str(checks/'fetch-durable-check.mjs')],60,env)]
    return [dict(name=name,command=cmd,cwd=str(root),environment=dict(child_env),timeoutSeconds=seconds,logPath=str(checks/('fetch-native-suite-'+name+'.log'))) for name,cmd,seconds,child_env in definitions]
def receipt(path,count):
    value=json.loads(checked(path,65536));require(type(value) is dict and type(value.get('passed')) is int and value['passed']==count and type(value.get('failed')) is int and value['failed']==0,'Exact fixture count/result required');return value
def zeros(value,keys):require(all(type(value.get(key)) is int and value[key]==0 for key in keys),'Exact zero-effect/normal-exit fields required')
def installer_parent(root,v,env):
