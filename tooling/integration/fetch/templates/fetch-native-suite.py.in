    require(env['PATH']=='/opt/homebrew/bin:/usr/bin:/bin' and env['LANG']=='C' and env['PYTHONDONTWRITEBYTECODE']==env['MODEL_PICKER_BROWSER']=='1','Reviewed fixed qenv values required')
