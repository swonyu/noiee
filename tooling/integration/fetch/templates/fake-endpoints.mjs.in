// In-process SDK boundary only. No stdio process or socket exists.
export class BoundedStdioTransport {
 constructor(params){this.params=params;this.label=params.command.split('/').at(-1);this.closed=false;this.closing=false;}
 close(){
  if(this.work)return this.work;
  this.closing=true;globalThis.mergedMCP.trace.push({kind:'close-requested',label:this.label});
  return this.work=(async()=>{await globalThis.mergedMCP.closeGates.get(this.label);this.closed=true;globalThis.mergedMCP.active.delete(this);globalThis.mergedMCP.trace.push({kind:'closed',label:this.label});})();
 }
}
export const StreamableHTTPClientTransport=BoundedStdioTransport;
export const ToolListChangedNotificationSchema={},ListToolsResultSchema={};
export const boundedResponse=()=>{throw Error('The fixture forbids a real HTTP response');};
export class Client {
 setNotificationHandler(_schema,fn){this.changed=fn;}
 async connect(transport,options){
  this.transport=transport;const f=globalThis.mergedMCP;f.initializes++;f.trace.push({kind:'initialize',label:transport.label});
  const gate=f.connectGates.get(transport.label);
  if(gate)await Promise.race([gate,new Promise((_,reject)=>{if(options.signal.aborted)reject(Error('Fixture connection cancelled'));else options.signal.addEventListener('abort',()=>reject(Error('Fixture connection cancelled')),{once:true});})]);
  options.signal.throwIfAborted();if(transport.closing)throw Error('Fixture transport already closing');f.active.add(transport);
 }
 async listTools(){const f=globalThis.mergedMCP;f.catalogs++;f.trace.push({kind:'catalog',label:this.transport.label});return{tools:structuredClone(f.catalogsByLabel.get(this.transport.label)??f.catalog)};}
 async request(){return this.listTools();}
 async callTool(){globalThis.mergedMCP.toolCalls++;throw Error('No tool/model replay is allowed in this fixture');}
}
