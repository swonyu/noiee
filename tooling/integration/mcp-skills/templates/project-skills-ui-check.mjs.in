import test from 'node:test';
import assert from 'node:assert/strict';
import vm from 'node:vm';
import {readFile} from 'node:fs/promises';
import {randomUUID} from 'node:crypto';
const script=await readFile(new URL('../../source/tools.js',import.meta.url),'utf8'),html=await readFile(new URL('../../source/index.html',import.meta.url),'utf8');
class Element {
 children=[];textContent='';hidden=false;disabled=false;value='';
 append(...values){this.children.push(...values);}
 replaceChildren(...values){this.children=[...values];}
}
const gate=()=>{let resolve;const promise=new Promise(r=>resolve=r);return {promise,resolve};};
async function until(fn){const end=Date.now()+2000;while(!fn()){if(Date.now()>end)throw Error('UI fixture timeout');await new Promise(r=>setTimeout(r,1));}}
function fixture({bridge=true}={}){
 const elements=new Map([...html.matchAll(/id="([^"]+)"/g)].map(x=>[x[1],new Element()])),events=new Map(),calls=[];
 let scope=null,states=new Map(),heldRead=null,fail=false;
 const catalog=['patch-verify','debug-one-cause','public-research'].map(id=>({id,name:id,description:'Fixed fixture procedure '+id}));
 const postMessage=async body=>{
  const request=JSON.parse(JSON.stringify(body));calls.push(request);
  if(request.op==='describe')return {servers:[]};
  if(request.op==='catalog')return {tools:[],builtins:[],total:0,nextOffset:null};
  if(request.op==='projectSkillsChoose'){scope={scopeId:randomUUID(),project:'/private/generated/selected-project'};return {scope,message:'Project selected.'};}
  if(request.op==='projectSkills'){
   if(fail)return {isError:true,message:'Fixture owner identity changed. No work admitted.'};
   const input=request.input;
   if(input.action==='catalog')return {catalog,scope};
   assert.equal(input.scopeId,scope.scopeId);
   if(input.action==='list')return {skills:catalog.map(x=>({id:x.id,installed:states.get(x.id)==='installed',state:states.get(x.id)||'not_installed'}))};
   if(input.action==='install'){states.set(input.id,'installed');return {installed:true,message:'Installed exact fixture skill.'};}
   if(input.action==='read')return heldRead?heldRead.promise:{text:'<img src=x onerror=throw>\nTask procedure only.'};
  }
  throw Error('Unexpected UI operation: '+JSON.stringify(request));
 };
 const window={...(bridge?{webkit:{messageHandlers:{tools:{postMessage}}}}:{}),addEventListener:(name,fn)=>{const list=events.get(name)||[];list.push(fn);events.set(name,list);}};
 const context={window,document:{getElementById:id=>{assert(elements.has(id),'Real HTML ID: '+id);return elements.get(id);},createElement:()=>new Element()},setContext:()=>{}};
 vm.runInNewContext(script,context,{filename:'actual-tools.js'});
 return {$:id=>elements.get(id),calls,scope:()=>scope,states,holdRead:()=>heldRead=gate(),fail:()=>fail=true,emit:name=>{if(scope)scope={...scope,scopeId:randomUUID()};for(const fn of events.get(name)||[])fn();}};
}

test('actual Tools UI chooses a project and dispatches only fixed install/read requests',async()=>{
 const f=fixture();f.$('open-tools').onclick();await until(()=>f.$('skills-catalog').children.length===3);
 assert(f.$('skills-catalog').children.every(row=>row.children[2].disabled));
 await f.$('skills-choose').onclick();assert.equal(f.$('skills-project').textContent,'/private/generated/selected-project');
 await f.$('skills-catalog').children[0].children[2].onclick();assert.equal(f.$('skills-catalog').children[0].children[2].textContent,'Installed');
 await f.$('skills-catalog').children[0].children[3].onclick();assert.equal(f.$('skills-preview').textContent,'<img src=x onerror=throw>\nTask procedure only.');assert.equal(f.$('skills-preview').children.length,0);assert.equal(f.$('skills-preview').hidden,false);
 assert.deepEqual(f.calls.filter(x=>x.op==='projectSkills'&&['install','read'].includes(x.input.action)).map(x=>x.input),[{action:'install',scopeId:f.scope().scopeId,id:'patch-verify'},{action:'read',scopeId:f.scope().scopeId,id:'patch-verify'}]);
 assert(!f.calls.some(x=>['addFilesystem','addBrowser','editConfig'].includes(x.op)));
});

test('Stop withholds a late read, then refresh uses the renewed scope without replay',async()=>{
 const f=fixture();await f.$('skills-choose').onclick();await f.$('skills-catalog').children[0].children[2].onclick();
 const held=f.holdRead(),read=f.$('skills-catalog').children[0].children[3].onclick();await until(()=>f.calls.some(x=>x.input?.action==='read'));
 const prior=f.scope().scopeId;f.emit('tools-stopped');held.resolve({text:'STALE_PRIVATE_PROCEDURE'});await read;
 assert.equal(f.$('skills-preview').textContent,'');assert.equal(f.$('skills-preview').hidden,true);assert.equal(f.$('skills-catalog').children.length,0);
 await f.$('skills-refresh').onclick();assert.notEqual(f.scope().scopeId,prior);assert.equal(f.calls.filter(x=>x.input?.action==='install').length,1);assert.equal(f.calls.filter(x=>x.input?.action==='read').length,1);
 assert.equal(f.$('skills-project').textContent,'/private/generated/selected-project');
});

test('changed or unmanaged targets are retained, and admission failure removes stale actionable state',async()=>{
 const f=fixture();await f.$('skills-choose').onclick();f.states.set('patch-verify','changed');f.states.set('debug-one-cause','unmanaged');await f.$('skills-refresh').onclick();
 assert(f.$('skills-catalog').children[0].children[2].disabled);assert(f.$('skills-catalog').children[1].children[2].disabled);
 f.fail();await f.$('skills-refresh').onclick();assert.match(f.$('skills-status').textContent,/identity changed/);assert.equal(f.$('skills-catalog').children.length,0);
 assert.equal(f.calls.filter(x=>x.input?.action==='install').length,0);
});

test('native-only project controls stay disabled without a bridge',()=>{
 const f=fixture({bridge:false});assert.equal(f.$('skills-choose').disabled,true);assert.equal(f.$('skills-refresh').disabled,true);assert.equal(f.calls.length,0);
});
