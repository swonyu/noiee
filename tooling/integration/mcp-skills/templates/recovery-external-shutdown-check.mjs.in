 const f=await fixture();await connect(f.hub);const r=await routed(f),before=mcpFixture.initializes,gate=defer();mcpFixture.closeGate=gate.promise;const closing=r.request('shutdown');await until(async()=>!(await f.hub.describe()).servers[0].connected);const stopping=r.request('stop');await new Promise(resolve=>setTimeout(resolve,10));gate.resolve();mcpFixture.closeGate=null;assert.equal((await closing).value.stopped,true);assert.equal((await stopping).value.stopped,true);const a=cold(f);await a.recover(async()=>{});assert.equal(mcpFixture.initializes,before);await a.close();
});
// Successor coverage: exercise the actual signed-route Stop orchestration with
// injected, gated external owners. No artifact bytes are fetched or executed.
const allClosureKeys=['coding','command','externalArtifacts','externalRuntime','git','inference','schedules','tools','worktrees'];
const departureClosureKeys=['command','externalArtifacts','externalRuntime','git','inference','tools','worktrees'];
const syntheticClosure={revision:'a'.repeat(64),launchID:'synthetic-owned-launch',outcome:'disconnected'};
const artifactInput={action:'install',url:'https://raw.githubusercontent.com/fixture/repository/'+'a'.repeat(40)+'/provider.mjs',sha256:'b'.repeat(64),purpose:'Disposable shutdown fixture; never download or execute'};
const nextTurn=()=>new Promise(resolve=>setImmediate(resolve));
async function externalRouted({download,stopRuntime}={}){
 const root=await fsp.mkdtemp(process.env.NOIEE_TOOLS_FIXTURE_ROOT+'/external-shutdown-');roots.push(root);
 const token=randomUUID(),calls=[],owner=name=>({async stop(reason){calls.push([name,'stop',reason??null]);return{stopped:true};},async close(){calls.push([name,'close',null]);return{stopped:true};}});
 const handler=toolRoutes({instanceToken:token,fullAccess:true,unconfinedBoot:true,
  hub:owner('tools'),coding:{...owner('coding'),dataDir:root,disposal:Promise.resolve()},worktrees:owner('worktrees'),gitWorkflow:owner('git'),schedules:owner('schedules'),
  localModels:{upstream:'http://127.0.0.1:9',async resolve(){throw Error('No model invocation allowed');}},fetchImpl:deny('network'),
  externalArtifactDownloader:async(input,options)=>{calls.push(['externalArtifacts','download',null]);assert.deepEqual(input,artifactInput);assert(download,'Unexpected artifact download');return download(input,options);},
  externalToolRuntime:{async stop(){calls.push(['externalRuntime','stop',null]);return stopRuntime?stopRuntime():{stopped:true,closures:[syntheticClosure]};}}
 });
 return{root,calls,handler,async request(operation,input={}){
  const route='/api/tools/'+operation,body=Buffer.from(JSON.stringify(input)),nonce=randomUUID(),time=String(Date.now()),req=Readable.from([body]),res=new Reply();
  Object.assign(req,{url:route,method:'POST',headers:{'content-type':'application/json','x-qwen-nonce':nonce,'x-qwen-time':time,'x-qwen-permit':nativeSignature(token,route,nonce,time,body)}});
  assert.equal(await handler(req,res,route,(status,value)=>{res.statusCode=status;res.end(JSON.stringify(value));}),true);
  return{status:res.statusCode,value:JSON.parse(Buffer.concat(res.parts).toString())};
 }};
}
function assertClosure(result,keys,stopped=true){
 assert.equal(result.status,200);assert.equal(result.value.stopped,stopped);assert.deepEqual(Object.keys(result.value.results).sort(),keys);
 for(const key of keys)if(key!=='externalRuntime')assert.equal(result.value.results[key].stopped,true,key+' must preserve its original closure result');
}
function assertOriginalOwners(calls,operation){
 const expected=operation==='shutdown'?[['coding','close',null],['git','close',null],['schedules','close',null],['tools','close',null],['worktrees','close',null]]:
  operation==='depart'?[['git','stop',null],['tools','stop','page-departure'],['worktrees','stop',null]]:
  [['coding','stop',null],['git','stop',null],['schedules','stop',null],['tools','stop','owner-stop'],['worktrees','stop',null]];
 assert.deepEqual(calls.filter(([name])=>!name.startsWith('external')).sort(),expected);
 assert.equal(calls.filter(([name])=>name==='externalRuntime').length,1,'Each requested drain must stop the runtime owner exactly once');
}
async function assertSavedShutdown(r,state){
 const status=await r.request('shutdownStatus');assert.equal(status.status,200);assert.equal(status.value.persistence,'saved');assert.equal(status.value.record.state,state);
 // The existing diagnostic schema retains the seven original per-owner rows;
 // aggregate uncertainty must still reflect either added external owner.
 assert.deepEqual(status.value.record.subsystems,{command:'closed',inference:'closed',tools:'closed',worktrees:'closed',git:'closed',schedules:'closed',coding:'closed'});
 const disk=JSON.parse(await fsp.readFile(r.root+'/shutdown/'+status.value.record.id+'.json','utf8'));assert.deepEqual(disk,status.value.record);
}
for(const operation of ['stop','shutdown','depart'])await test(operation+' aborts external download and independently awaits download cleanup and runtime closure',async()=>{
 for(const releaseFirst of ['download','runtime']){
  const entered=defer(),aborted=defer(),downloadDrain=defer(),runtimeEntered=defer(),runtimeDrain=defer();let downloadDone=false,runtimeDone=false,finished=false;
  const r=await externalRouted({download:async(_,{signal})=>{signal.throwIfAborted();signal.addEventListener('abort',()=>aborted.resolve(),{once:true});entered.resolve();await aborted.promise;await downloadDrain.promise;downloadDone=true;signal.throwIfAborted();assert.fail('Aborted download must never produce artifact bytes');},stopRuntime:async()=>{runtimeEntered.resolve();await runtimeDrain.promise;runtimeDone=true;return{stopped:true,closures:[syntheticClosure]};}});
  const pending=r.request('externalArtifact',artifactInput);await entered.promise;
  const stopping=r.request(operation).then(result=>{finished=true;return result;});await Promise.all([aborted.promise,runtimeEntered.promise]);await nextTurn();assert.equal(finished,false);
  (releaseFirst==='download'?downloadDrain:runtimeDrain).resolve();await until(()=>releaseFirst==='download'?downloadDone:runtimeDone);await nextTurn();assert.equal(finished,false,'Drain must not finish while the other external owner is still pending');
  (releaseFirst==='download'?runtimeDrain:downloadDrain).resolve();const cancelled=await pending,closed=await stopping;
  assert.equal(cancelled.status,400);assert.match(cancelled.value.error,/abort/i);assert(downloadDone&&runtimeDone);
  assertClosure(closed,operation==='depart'?departureClosureKeys:allClosureKeys);assert.deepEqual(closed.value.results.externalRuntime,{stopped:true,closures:[syntheticClosure]});assert.deepEqual(closed.value.results.externalArtifacts,{stopped:true});assertOriginalOwners(r.calls,operation);
  assert.equal(r.calls.filter(([name])=>name==='externalArtifacts').length,1);
  if(operation==='shutdown')await assertSavedShutdown(r,'closed');
 }
});
await test('partial external runtime closure remains unconfirmed and preserves closure evidence after shutdown',async()=>{
 const partial={stopped:false,closures:[syntheticClosure],message:'Synthetic second launch remains unconfirmed'},r=await externalRouted({stopRuntime:async()=>partial});
 const result=await r.request('shutdown');assertClosure(result,allClosureKeys,false);assert.deepEqual(result.value.results.externalRuntime,partial);assert.match(result.value.message,/Unconfirmed subsystems: externalRuntime\./);assertOriginalOwners(r.calls,'shutdown');await assertSavedShutdown(r,'unconfirmed');
});
await test('throwing external runtime owner cannot report clean shutdown or suppress original closure results',async()=>{
 const r=await externalRouted({stopRuntime:async()=>{throw Object.assign(Error('Synthetic external close failure'),{code:'FIXTURE_UNCONFIRMED'});}}),result=await r.request('shutdown');
 assertClosure(result,allClosureKeys,false);assert.deepEqual(result.value.results.externalRuntime,{stopped:false,message:'Synthetic external close failure',code:'FIXTURE_UNCONFIRMED'});assert.match(result.value.message,/Unconfirmed subsystems: externalRuntime\./);assertOriginalOwners(r.calls,'shutdown');await assertSavedShutdown(r,'unconfirmed');
});
await test('concurrent and repeated shutdown share one external drain and fence new artifact admissions',async()=>{
 const entered=defer(),aborted=defer(),downloadDrain=defer(),runtimeEntered=defer(),runtimeDrain=defer();let finished=0;
 const r=await externalRouted({download:async(_,{signal})=>{signal.addEventListener('abort',()=>aborted.resolve(),{once:true});entered.resolve();await aborted.promise;await downloadDrain.promise;signal.throwIfAborted();assert.fail('Stopped artifact must not return');},stopRuntime:async()=>{runtimeEntered.resolve();await runtimeDrain.promise;return{stopped:true,closures:[syntheticClosure]};}});
 const pending=r.request('externalArtifact',artifactInput);await entered.promise;
 const first=r.request('shutdown').then(result=>{finished++;return result;});await Promise.all([aborted.promise,runtimeEntered.promise]);const second=r.request('shutdown').then(result=>{finished++;return result;});
 const shared=r.handler.close();assert.equal(shared,r.handler.close(),'Close promise must be shared');await nextTurn();assert.equal(finished,0);
 assert.equal((await r.request('externalArtifact',artifactInput)).status,503);assert.equal(r.calls.filter(([name])=>name==='externalArtifacts').length,1);
 runtimeDrain.resolve();await nextTurn();assert.equal(finished,0);downloadDrain.resolve();assert.equal((await pending).status,400);
 const a=await first,b=await second;assertClosure(a,allClosureKeys);assert.deepEqual(a,b);assert.deepEqual(a.value,await shared);assert.deepEqual(await r.request('shutdown'),a);assertOriginalOwners(r.calls,'shutdown');await assertSavedShutdown(r,'closed');
 assert.equal((await r.request('externalArtifact',artifactInput)).status,503);assert.equal(r.calls.filter(([name])=>name==='externalArtifacts').length,1);
});
